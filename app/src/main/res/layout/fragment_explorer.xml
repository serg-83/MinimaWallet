<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:background="@color/card_background">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/explorer_back_btn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/on_surface"
            app:iconSize="22dp"
            android:contentDescription="@string/explorer_back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/explorer_refresh_btn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:icon="@drawable/ic_refresh"
            app:iconTint="@color/on_surface"
            app:iconSize="22dp"
            android:contentDescription="@string/explorer_refresh" />

        <ProgressBar
            android:id="@+id/explorer_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:progressTint="@color/primary_color"
            android:visibility="gone"
            android:indeterminate="true" />

    </LinearLayout>

    <WebView
        android:id="@+id/explorer_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
