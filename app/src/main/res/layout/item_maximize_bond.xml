<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: amount + status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/bond_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/bond_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:background="@drawable/bg_badge_locked" />

        </LinearLayout>

        <!-- Income info -->
        <TextView
            android:id="@+id/bond_income"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="4dp" />

        <!-- Unlock date -->
        <TextView
            android:id="@+id/bond_unlock_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/on_card_label"
            android:layout_marginBottom="10dp" />

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/bond_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginBottom="10dp"
            android:progressTint="@color/primary_color"
            android:progressBackgroundTint="@color/card_stroke"
            android:max="100" />

        <!-- Cancel button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bond_cancel_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/maximize_cancel_stake"
            style="@style/Widget.Material3.Button.TonalButton"
            app:cornerRadius="12dp"
            android:textSize="14sp"
            android:paddingHorizontal="8dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
